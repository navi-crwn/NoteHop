# /etc/notehop/notehop.env: settings for the notehop service.
# After editing: sudo systemctl restart notehop

# Listen only on localhost; Caddy/nginx in front serves HTTPS.
NOTEHOP_ADDR=127.0.0.1:8090
NOTEHOP_DB=/var/lib/notehop/notehop.db
# Public address, without a trailing slash. https:// turns on Secure cookies + HSTS.
NOTEHOP_BASE_URL=https://note.example.com
# Secure cookies + HSTS. Default: on when NOTEHOP_BASE_URL is https.
# NOTEHOP_SECURE_COOKIES=true
# Optional short domain for links handed to readers (e.g. https://nhop.link):
# nhop.link/TOKEN redirects to NOTEHOP_BASE_URL/TOKEN, where notes open.
# Owner links stay on NOTEHOP_BASE_URL.
NOTEHOP_SHARE_URL=
# Behind Caddy/nginx: use X-Forwarded-For for rate limiting.
NOTEHOP_TRUST_PROXY=1
NOTEHOP_REGISTRATION=1
NOTEHOP_SITE=NoteHop

# Encrypted attachments, kept 24 hours. FILE_MB=0 turns them off. If you
# raise FILE_MB, raise client_max_body_size in nginx too.
NOTEHOP_FILE_MB=5
NOTEHOP_FILES_TOTAL_MB=10240
NOTEHOP_MIN_FREE_MB=1024
NOTEHOP_MIN_FREE_PERCENT=5
# What one address may upload per 24 hours (MB); 0 = no limit.
NOTEHOP_FILES_IP_MB=100

# Optional extras (empty = off):
# SSH for public notes:  ssh -p 2222 note.example.com < file.md
#   (open the port in the firewall: sudo ufw allow 2222/tcp)
NOTEHOP_SSH_ADDR=
# SSH host key, made on first start. Default: ssh_host_ed25519_key next to the database.
# NOTEHOP_SSH_KEY=
# Telegram bot that feeds note inboxes (token from @BotFather).
TELEGRAM_BOT_TOKEN=

# Single sign-on with an account server you run. Leave NOTEHOP_SSO_URL empty
# to use NoteHop's own accounts only. NoteHop sends visitors to
# <NOTEHOP_SSO_URL>/sso/<NOTEHOP_SSO_CLIENT> and takes tickets back at
# <NOTEHOP_BASE_URL>/auth/sso/callback; the secret (32+ chars) is shared with
# the account server:  openssl rand -hex 32
NOTEHOP_SSO_URL=
NOTEHOP_SSO_SECRET=
NOTEHOP_SSO_NAME=
NOTEHOP_SSO_CLIENT=notehop
# Extra buttons straight to a provider on the account server, for example google=Google.
NOTEHOP_SSO_PROVIDERS=
# Apps that may call the signed /hop/* API with NOTEHOP_SSO_SECRET.
# NOTEHOP_HOP_CLIENTS=imperium,helink
# HOP apps that may list a member's public notes for a picker (GET /api/v1/me/notes, signed, X-HOP-Actor = the
# member's HOP ID): BioHop's "Choose from NoteHop". Only public notes with a read-only link are listed, never an
# encrypted note. Default biohop; set it empty to turn the route off. An app with its own secret in the family signs
# with HOP_SSO_SECRET_<APP>, for example HOP_SSO_SECRET_BIOHOP; otherwise NOTEHOP_SSO_SECRET verifies it.
# NOTEHOP_NOTES_CLIENTS=biohop
# HOP_SSO_SECRET_BIOHOP=

# Related sites in the footer: Name=URL pairs, comma separated.
NOTEHOP_LINKS=

# Writing help: on (on-device AI + own API key), device (built-in AI only) or off.
# NOTEHOP_AI=on
# Extra origins for the "Other" AI provider, comma separated.
NOTEHOP_AI_ORIGINS=
# GitHub repository (owner/name) whose numbers show on the home page; - hides them.
# NOTEHOP_GITHUB=navi-crwn/NoteHop
# Allow Watch webhooks to private addresses and http:// (own network only).
# NOTEHOP_PRIVATE_HOOKS=false
# Usernames given the admin role at start, comma separated.
NOTEHOP_ADMINS=
# Extra reserved names, comma separated.
NOTEHOP_RESERVED=
# Email or URL for contact and abuse reports, shown on /contact.
NOTEHOP_CONTACT=

# Daily backups (notehop-backup.timer)
NOTEHOP_BACKUP_DIR=/var/lib/notehop/backups
NOTEHOP_BACKUP_KEEP_DAYS=14

# Command line client only, not the server: the address for `notehop new` and
# the extra password for `new` and `get`.
# NOTEHOP_SERVER=http://127.0.0.1:8080
# NOTEHOP_PASSWORD=
