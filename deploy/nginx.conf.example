# /etc/nginx/sites-available/notehop
# Certificate: sudo certbot --nginx -d note.example.com
server {
    listen 80;
    listen [::]:80;
    server_name note.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name note.example.com;

    ssl_certificate     /etc/letsencrypt/live/note.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/note.example.com/privkey.pem;

    # Notes are up to 1 MB of ciphertext; attachments up to NOTEHOP_FILE_MB
    # (default 20, the most one note may hold) plus a little encryption overhead.
    client_max_body_size 21m;

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        # NoteHop reads the first X-Forwarded-For entry for rate limiting, so
        # set it to the real client instead of appending to what the client sent.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Attachment uploads: up to 20 MB from a slow phone connection needs minutes, not the default 60 s.
    location ~ ^/api/(files|n/[^/]+/files)$ {
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 21m;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Live collaboration (WebSocket). The server pings every 30 s, so the
    # 60 s read timeout only closes connections that are really gone.
    location ~ ^/api/n/[^/]+/live$ {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }

    # Nearby devices (signalling for WebRTC, WebSocket).
    location = /api/nearby {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }
}
