# /etc/caddy/Caddyfile: Caddy gets and renews the HTTPS certificate itself.
# Point the domain's DNS A/AAAA record at the VPS first.
note.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8090
	# NoteHop sets its own security headers (CSP, HSTS, ...); nothing to add here.
}

# Optional short domain for shared links (NOTEHOP_SHARE_URL=https://nhop.link):
# it only redirects to the main site, keeping the path (nhop.link/TOKEN →
# note.example.com/TOKEN). Proxying it to NoteHop does the same.
# nhop.link {
# 	redir https://note.example.com{uri} permanent
# }
